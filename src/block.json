{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-app/our-team-block",
	"version": "1.1.0",
	"title": "Our Team",
	"category": "widgets",
	"icon": "groups",
	"description": "Shows a title, a description and your team members as hexagons, each with a photo, a name, a position and an optional link.",
	"keywords": [ "team", "staff", "people", "members", "about" ],
	"example": {
		"attributes": { "columns": 2 },
		"innerBlocks": [
			{
				"name": "wp-app/our-team-block-column",
				"innerBlocks": [
					{
						"name": "wp-app/our-team-block-text",
						"attributes": {
							"title": "Our team",
							"description": "The people behind the project."
						}
					}
				]
			},
			{
				"name": "wp-app/our-team-block-column",
				"innerBlocks": [
					{
						"name": "wp-app/our-team-block-team-list",
						"innerBlocks": [
							{
								"name": "wp-app/our-team-block-team-member",
								"attributes": { "name": "Ann Lee", "position": "CEO" }
							},
							{
								"name": "wp-app/our-team-block-team-member",
								"attributes": { "name": "Bob Stone", "position": "Developer" }
							},
							{
								"name": "wp-app/our-team-block-team-member",
								"attributes": { "name": "Cleo Park", "position": "Designer" }
							},
							{
								"name": "wp-app/our-team-block-team-member",
								"attributes": { "name": "Dan Ford", "position": "Support" }
							}
						]
					}
				]
			}
		]
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"textdomain": "our-team-block",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 2
		}
	}
}
